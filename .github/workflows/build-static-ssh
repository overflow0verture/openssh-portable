name: portable-openssh

on:
  workflow_dispatch:
  push:

jobs:

  build:
    runs-on: ubuntu-latest

    steps:

    - uses: actions/checkout@v4

    - name: Install deps
      run: |
        sudo apt update
        sudo apt install -y \
          build-essential \
          wget \
          autoconf \
          automake \
          libtool \
          pkg-config \
          musl-tools \
          mingw-w64 \
          zlib1g-dev \
          libssl-dev

    - name: Download OpenSSH
      run: |
        wget https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-9.7p1.tar.gz
        tar xzf openssh-9.7p1.tar.gz

    ##################################
    # Linux static
    ##################################

    - name: Build Linux static ssh
      run: |
        cd openssh-9.7p1

        CC=musl-gcc ./configure \
          --without-pam \
          --disable-shared \
          --enable-static \
          LDFLAGS="-static"

        make -j$(nproc) \
          ssh scp sftp ssh-keygen ssh-keyscan

        mkdir ../release

        cp ssh scp sftp ssh-keygen ssh-keyscan ../release/

    ##################################
    # Windows build
    ##################################

    - name: Clean
      run: |
        cd openssh-9.7p1
        make distclean || true

    - name: Configure windows
      run: |
        cd openssh-9.7p1

        ./configure \
          --host=x86_64-w64-mingw32 \
          --without-pam

    - name: Build windows
      run: |
        cd openssh-9.7p1

        make -j$(nproc) \
          ssh scp sftp ssh-keygen ssh-keyscan

        cp ssh.exe scp.exe sftp.exe ssh-keygen.exe ssh-keyscan.exe ../release/

    ##################################
    # Package
    ##################################

    - name: Package
      run: |
        cd release

        tar czf ../openssh-linux.tar.gz ssh scp sftp ssh-keygen ssh-keyscan
        zip ../openssh-windows.zip ssh.exe scp.exe sftp.exe ssh-keygen.exe ssh-keyscan.exe

    ##################################
    # Upload
    ##################################

    - uses: actions/upload-artifact@v4
      with:
        name: portable-openssh
        path: |
          openssh-linux.tar.gz
          openssh-windows.zip
