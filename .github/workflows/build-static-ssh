name: build-portable-ssh

on:
  workflow_dispatch:
  push:

jobs:

  build:
    runs-on: ubuntu-latest

    steps:

    - name: Install deps
      run: |
        sudo apt update
        sudo apt install -y \
          build-essential \
          wget \
          autoconf \
          automake \
          libtool \
          pkg-config \
          zlib1g-dev \
          libssl-dev \
          mingw-w64 \
          musl-tools

    - name: Download OpenSSH
      run: |
        wget https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-9.7p1.tar.gz
        tar xzf openssh-9.7p1.tar.gz

    ########################
    # Linux static build
    ########################

    - name: Build Linux static ssh
      run: |
        cd openssh-9.7p1

        CC=musl-gcc ./configure \
          --without-pam \
          --disable-shared \
          --enable-static \
          LDFLAGS="-static"

        make ssh -j$(nproc)

        mkdir ../release
        cp ssh ../release/ssh-linux

    ########################
    # Windows build
    ########################

    - name: Build Windows ssh
      run: |
        cd openssh-9.7p1

        make distclean || true

        ./configure \
          --host=x86_64-w64-mingw32 \
          --without-pam

        make ssh -j$(nproc)

        cp ssh.exe ../release/

    ########################
    # Upload
    ########################

    - name: Upload
      uses: actions/upload-artifact@v4
      with:
        name: ssh-portable
        path: release/*
